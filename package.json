{
  "name": "ait-workspace",
  "version": "0.0.24",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/mobile",
    "apps/desktop",
    "packages/protocol",
    "packages/client",
    "packages/highlight",
    "packages/expo-two-way-audio"
  ],
  "scripts": {
    "verify:release": "node scripts/verify-release-version.mjs",
    "generate:icons": "node scripts/generate-brand-assets.mjs",
    "check:icons": "node scripts/generate-brand-assets.mjs --check",
    "check:docs": "node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "build:daemon": "cargo build -p daemon --bin daemon",
    "build:ui-deps": "npm run build:sdk && npm run build:highlight && npm run build --workspace=@ait/expo-two-way-audio",
    "postinstall": "node scripts/postinstall-patches.mjs",
    "build:sdk": "npm run build --workspace=@ait/client",
    "build:client": "npm run build:sdk",
    "test:sdk": "npm run build:sdk && npm run test --workspace=@ait/protocol --workspace=@ait/client",
    "build:protocol": "npm run build --workspace=@ait/protocol",
    "build:highlight": "npm run build --workspace=@ait/highlight",
    "watch:protocol": "npm run watch --workspace=@ait/protocol",
    "watch:client": "tsc -p packages/client/tsconfig.json --watch --preserveWatchOutput",
    "build:desktop": "npm run build:desktop-assets && npm run build --workspace=@ait/desktop",
    "dev:mobile": "node apps/mobile/scripts/dev-server.mjs",
    "build:desktop-assets": "npm run build:ui-deps && npm exec --workspace=@ait/mobile -- cross-env AIT_WEB_PLATFORM=electron expo export --platform web",
    "build:dmg": "npm run build:dmg --workspace=@ait/desktop",
    "build:dmg:release": "npm run build:dmg:release --workspace=@ait/desktop",
    "build:ios": "npm run build:ios --workspace=@ait/mobile",
    "build:ios:simulator": "npm run build:ios:simulator --workspace=@ait/mobile",
    "build:ios:ipa": "npm run build:ios:ipa --workspace=@ait/mobile",
    "package:linux": "npm run package:linux --workspace=@ait/desktop",
    "package:mac": "npm run package:mac --workspace=@ait/desktop",
    "test:release": "node --test scripts/nightly-workflow.test.mjs scripts/release-assets.test.mjs scripts/release-layout.test.mjs scripts/prepare-desktop-daemon.test.mjs scripts/verify-packaged-resources.test.cjs",
    "test:mobile-release": "node --test apps/mobile/scripts/eas-submit-tracks.test.cjs apps/mobile/scripts/ios-testflight-workflow.test.cjs scripts/ios-testflight-release.test.mjs scripts/android-release.test.mjs scripts/android-test-release.test.mjs scripts/android-play-release.test.mjs",
    "dev:desktop": "npm run dev --workspace=@ait/desktop",
    "build:desktop-main": "npm run build:ui-deps && npm run build:main --workspace=@ait/desktop",
    "verify:local-packages": "node scripts/verify-local-packages.mjs"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "get-port-cli": "^3.0.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.56.1",
    "sharp": "0.34.5",
    "typescript": "^5.9.3",
    "yaml": "2.8.4"
  },
  "overrides": {
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.6",
    "lightningcss": "1.30.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3"
  }
}
