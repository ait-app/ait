  "cases": [
    {
      "name": "rejects scattered letters across words while keeping within-word subsequences",
      "query": "terminal",
      "fields": [
        "",
        "Let me diagnose this problem in a diagnose this problem and",
        "",
        "getpaseo/paseo"
      ],
      "expected": false
    },
    {
      "name": "rejects scattered letters across words while keeping within-word subsequences",
      "query": "trmnl",
      "fields": [
        "",
        "Fix terminal resizing",
        "",
        "getpaseo/paseo"
      ],
      "expected": true
    },
    {
      "name": "matches the workspace name",
      "query": "stripe",
      "fields": [
        "Add Stripe billing",
        "",
        "",
        "getpaseo/paseo"
      ],
      "expected": true
    },
    {
      "name": "matches the agent title",
      "query": "entitlements",
      "fields": [
        "",
        "Reshape entitlements",
        "",
        "getpaseo/paseo"
      ],
      "expected": true
    },
    {
      "name": "matches the branch name",
      "query": "billing",
      "fields": [
        "",
        "",
        "add-stripe-billing",
        "getpaseo/paseo"
      ],
      "expected": true
    },
    {
      "name": "matches the project name",
      "query": "paseo",
      "fields": [
        "",
        "",
        "",
        "getpaseo/paseo"
      ],
      "expected": true
    },
    {
      "name": "requires every token to match somewhere",
      "query": "stripe main",
      "fields": [
        "Add Stripe billing",
        "",
        "main",
        "getpaseo/paseo"
      ],
      "expected": true
    },
    {
      "name": "requires every token to match somewhere",
      "query": "stripe rosetta",
      "fields": [
        "Add Stripe billing",
        "",
        "main",
        "getpaseo/paseo"
      ],
      "expected": false
    },
    {
      "name": "tolerates a typo",
      "query": "bulling",
      "fields": [
        "Add Stripe billing",
        "",
        "",
        "getpaseo/paseo"
      ],
      "expected": true
    },
    {
      "name": "tolerates a transposed branch name",
      "query": "mian",
      "fields": [
        "",
        "",
        "main",
        "getpaseo/paseo"
      ],
      "expected": true
    },
    {
      "name": "tolerates a transposed branch name",
      "query": "rain",
      "fields": [
        "",
        "",
        "main",
        "getpaseo/paseo"
      ],
      "expected": false
    },
    {
      "name": "keeps candidates for a blank query",
      "query": "   ",
      "fields": [
        "",
        "anything",
        "",
        "getpaseo/paseo"
      ],
      "expected": true
    }
  ],
