[
  {
    "name": "create_agent",
    "methods": ["agent.create.request"],
    "description": "Create and start an agent using a provider/model pair. Supply cwd or workspaceId for an external caller. X-Ait-Agent-Id inherits the caller workspace and records parentage. Returns after initial prompt admission. Reuse idempotencyKey on retries.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "initialPrompt": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object",
          "properties": {
            "modeId": {
              "type": "string",
              "minLength": 1
            },
            "thinkingOptionId": {
              "type": ["string", "null"]
            },
            "features": {
              "type": "object"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "autoArchive": {
          "type": "boolean"
        },
        "ticketId": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace Bot sessions only: an open ticket from bot_tickets that the new agent joins. Omit it to open a new ticket for this task."
        }
      },
      "required": ["provider", "title", "initialPrompt"],
      "additionalProperties": false
    },
    "readOnly": false
  },
  {
    "name": "send_agent_prompt",
