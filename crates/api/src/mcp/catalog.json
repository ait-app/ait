  {
    "name": "create_workspace",
    "methods": ["workspace.create.request"],
    "description": "Create an Ait workspace from an existing directory or an isolated managed worktree. Select branch-off, checkout-branch or checkout-pr. sandboxed-worktree also confines every Agent process to writing inside the worktree (macOS only). Reuse idempotencyKey on retries.",
