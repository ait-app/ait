+import type { SlashCommandIconName } from "@oh-my-pi/pi-tui/theme/symbols";
+import type { SlashCommand } from "@oh-my-pi/pi-tui";
+import { replaceTabs } from "@oh-my-pi/pi-tui/render/render-utils";
+import { buildStaticInlineHint, type BuiltinCompletionRuntime } from "./builtin-completions";
+import { BUILTIN_SLASH_COMMAND_RESERVED_NAMES } from "./builtin-registry";
+
+type CompletionContext = BuiltinCompletionRuntime["ctx"];
+type Icon = (name: SlashCommandIconName) => string | undefined;
+
+/** Live extension/custom/skill commands, shared by terminal and remote editors. */
+export function buildPendingCompletionCommands(
+	ctx: CompletionContext,
+	builtinCommands: SlashCommand[],
+	icon: Icon,
+	reservedNames: ReadonlySet<string> = BUILTIN_SLASH_COMMAND_RESERVED_NAMES,
+): SlashCommand[] {
+	const hookCommands: SlashCommand[] = (ctx.session.extensionRunner?.getRegisteredCommands(reservedNames) ?? []).map(
+		cmd => ({
+			name: cmd.name,
+			description: cmd.description ?? "(hook command)",
+			icon: icon("extension"),
+			iconName: "extension",
+			getArgumentCompletions: cmd.getArgumentCompletions,
+		}),
+	);
+
+	// Convert custom commands (TypeScript) to SlashCommand format
+	const customCommands: SlashCommand[] = ctx.session.customCommands.map(loaded => {
+		const complete = loaded.command.getArgumentCompletions?.bind(loaded.command);
+		return {
+			name: loaded.command.name,
+			description: `${loaded.command.description} (${loaded.source})`,
+			icon: icon(loaded.path.startsWith("mcp:") ? "mcp" : "prompt"),
+			iconName: loaded.path.startsWith("mcp:") ? "mcp" : "prompt",
+			getArgumentCompletions: complete && (prefix => complete(prefix, ctx.sessionManager.getCwd())),
+		};
+	});
+
+	const skillCommandList: SlashCommand[] = [];
+
+	if (ctx.session.skillsSettings?.enableSkillCommands !== false) {
+		const skillIcon = icon("skill");
+		for (const skill of ctx.session.skills) {
+			const commandName = `skill:${skill.name}`;
+
+			skillCommandList.push({
+				name: commandName,
+				description: skill.description,
+				icon: skillIcon,
+				iconName: "skill",
+			});
+		}
+	}
+
+	return [...builtinCommands, ...hookCommands, ...customCommands, ...skillCommandList];
+}
+
+/** File commands and unshadowed templates in native execution resolution order. */
+export function buildFileCompletionCommands(
+	ctx: CompletionContext,
+	pending: SlashCommand[],
+	icon: Icon,
+): SlashCommand[] {
+	const fileCommands = ctx.session.slashCommands;
+	const promptIcon = icon("prompt");
+	const fileSlashCommands: SlashCommand[] = fileCommands.map(cmd => {
+		const argumentHint = cmd.argumentHint ? replaceTabs(cmd.argumentHint).replace(/[\r\n]+/g, " ") : undefined;
+		return {
+			name: cmd.name,
+			description: cmd.description,
+			icon: promptIcon,
+			iconName: "prompt",
+			argumentHint,
+			getInlineHint: argumentHint ? buildStaticInlineHint(argumentHint) : undefined,
+		};
+	});
+	// Surface discovered prompt templates in the picker. AgentSession.prompt() expands
+	// `expandSlashCommand` before `expandPromptTemplate`, and builtin command
+	// execution resolves aliases before template expansion. Mirror that command
+	// resolution order by skipping templates whose names already appear in any
+	// builtin/hook/custom/skill/file command token.
+	const reservedNames = new Set<string>();
+	for (const command of pending) {
+		reservedNames.add(command.name);
+		for (const alias of command.aliases ?? []) reservedNames.add(alias);
+	}
+	for (const command of fileSlashCommands) {
+		reservedNames.add(command.name);
+		for (const alias of command.aliases ?? []) reservedNames.add(alias);
+	}
+	const promptTemplateCommands: SlashCommand[] = ctx.session.promptTemplates
+		.filter(template => !reservedNames.has(template.name))
+		.map(template => ({
+			name: template.name,
+			// `PromptTemplate.description` from `loadTemplatesFromDir` already includes the
+			// source suffix (e.g. "Review code (project)"), so pass it through verbatim.
+			description: template.description,
+			icon: promptIcon,
+			iconName: "prompt",
+		}));
+	return [...fileSlashCommands, ...promptTemplateCommands];
+}
