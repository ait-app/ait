--- /dev/null
+++ b/packages/coding-agent/src/slash-commands/session-completion.ts
@@ -0,0 +1,201 @@
+/** Native editor completion shared by ACP and RPC. No command execution or TUI emulation. */
+import type { AutocompleteProvider } from "@oh-my-pi/pi-tui";
+import { PromptActionAutocompleteProvider } from "@oh-my-pi/pi-tui/prompt/prompt-action-autocomplete";
+import { createModelMentionSource } from "@oh-my-pi/pi-tui/prompt/model-mention-autocomplete";
+import { getSlashCommandTypeIcon } from "@oh-my-pi/pi-tui/theme/tui-adapters";
+import { logger } from "@oh-my-pi/pi-utils";
+import type { AutocompleteProviderFactory } from "../extensibility/extensions/types";
+import type { BuiltinCompletionRuntime } from "./builtin-completions";
+import { ACP_BUILTIN_RESERVED_NAMES, isAcpBuiltinShadowedName } from "./acp-builtins";
+import { lookupBuiltinSlashCommand, buildBuiltinCompletionCommands } from "./builtin-registry";
+import { buildFileCompletionCommands, buildPendingCompletionCommands } from "./completion-commands";
+import { createModelBrowserSource } from "../modes/model-browser-source";
+import { commandUsage } from "../utils/usage-counter";
+
+export interface CompletionInput {
+	text: string;
+	cursor: number;
+}
+export interface CompletionItem {
+	id: string;
+	label: string;
+	insertText: string;
+	replaceRange: { start: number; end: number };
+	description?: string;
+	hint?: string;
+	kind?: string;
+	cursor: number;
+	triggerCompletion: boolean;
+}
+export interface CompletionResult {
+	supported: true;
+	items: CompletionItem[];
+}
+
+function boundary(text: string, offset: number): boolean {
+	if (!Number.isSafeInteger(offset) || offset < 0 || offset > text.length) return false;
+	const left = text.charCodeAt(offset - 1),
+		right = text.charCodeAt(offset);
+	return !(left >= 0xd800 && left <= 0xdbff && right >= 0xdc00 && right <= 0xdfff);
+}
+
+/** Validate an untrusted remote editor state before invoking any extension. */
+export function validateCompletionInput(value: unknown): CompletionInput {
+	if (!value || typeof value !== "object") throw new Error("Invalid completion input");
+	const { text, cursor } = value as Partial<CompletionInput>;
+	if (
+		typeof text !== "string" ||
+		Buffer.byteLength(text) > 65536 ||
+		text.includes("\0") ||
+		typeof cursor !== "number" ||
+		!boundary(text, cursor)
+	)
+		throw new Error("Invalid completion input");
+	return { text, cursor };
+}
+
+/** Minimal edit, preserving all native quoting, spacing, suffixes and the native caret. */
+export function completionEdit(
+	before: string,
+	after: string,
+): { insertText: string; replaceRange: { start: number; end: number } } {
+	let start = 0;
+	while (start < before.length && start < after.length && before[start] === after[start]) start++;
+	while (!boundary(before, start) || !boundary(after, start)) start--;
+	let end = before.length,
+		afterEnd = after.length;
+	while (end > start && afterEnd > start && before[end - 1] === after[afterEnd - 1]) {
+		end--;
+		afterEnd--;
+	}
+	while (!boundary(before, end) || !boundary(after, afterEnd)) {
+		end++;
+		afterEnd++;
+	}
+	return { insertText: after.slice(start, afterEnd), replaceRange: { start, end } };
+}
+
+/** Owns extension factory registrations for one existing session; creates no second session. */
+export class SessionCompletion {
+	#factories: AutocompleteProviderFactory[] = [];
+	#active: AbortController | undefined;
+	constructor(private readonly context: () => BuiltinCompletionRuntime["ctx"]) {}
+
+	add(factory: AutocompleteProviderFactory): void {
+		this.#factories.push(factory);
+	}
+	reset(): void {
+		this.#active?.abort();
+		this.#factories = [];
+	}
+
+	#provider(): AutocompleteProvider {
+		const ctx = this.context();
+		const builtin = buildBuiltinCompletionCommands({ ctx })
+			.filter(cmd => lookupBuiltinSlashCommand(cmd.name)?.handle)
+			.map(cmd => ({
+				...cmd,
+				icon: getSlashCommandTypeIcon(cmd.icon ?? "action"),
+				iconName: cmd.icon ?? "action",
+			}));
+		const pending = buildPendingCompletionCommands(
+			ctx,
+			builtin,
+			getSlashCommandTypeIcon,
+			ACP_BUILTIN_RESERVED_NAMES,
+		).filter(
+			cmd =>
+				(cmd.iconName !== "extension" || !isAcpBuiltinShadowedName(cmd.name)) &&
+				(cmd.iconName !== "skill" || ctx.session.skillsSettings?.enableSkillCommands === true),
+		);
+		const manager = ctx.viewSession.sessionManager;
+		let provider: AutocompleteProvider = new PromptActionAutocompleteProvider(
+			[...pending, ...buildFileCompletionCommands(ctx, pending, getSlashCommandTypeIcon)],
+			ctx.sessionManager.getCwd(),
+			[],
+			name => commandUsage.get(name),
+			() => ({
+				cwd: manager.getCwd(),
+				sessionId: manager.getSessionId(),
+				sessionFile: manager.getSessionFile(),
+				seanceSourceArtifactsDir: manager.getSeanceSourceArtifactsDir() ?? undefined,
+			}),
+			createModelMentionSource({
+				source: createModelBrowserSource(ctx.settings, model => ctx.session.effectiveServiceTier(model)),
+				registry: ctx.session.modelRegistry,
+				scopedModels: () => ctx.session.scopedModels.map(entry => entry.model),
+			}),
+		);
+		for (const factory of this.#factories) {
+			try {
+				const wrapped = factory(provider);
+				if (
+					wrapped &&
+					typeof wrapped.getSuggestions === "function" &&
+					typeof wrapped.applyCompletion === "function"
+				)
+					provider = wrapped;
+				else logger.warn("Extension autocomplete factory returned an invalid provider; skipping it");
+			} catch (error) {
+				logger.warn("Extension autocomplete factory threw; skipping it", { error: String(error) });
+			}
+		}
+		return provider;
+	}
+
+	async complete(value: unknown): Promise<CompletionResult> {
+		const input = validateCompletionInput(value);
+		this.#active?.abort();
+		const controller = new AbortController();
+		this.#active = controller;
+		const timer = setTimeout(() => controller.abort(), 750);
+		const aborted = Promise.withResolvers<never>();
+		const rejectAbort = () => aborted.reject(new Error("Completion cancelled or timed out"));
+		controller.signal.addEventListener("abort", rejectAbort, { once: true });
+		try {
+			const provider = this.#provider();
+			const before = input.text.slice(0, input.cursor).split("\n");
+			const line = before.length - 1,
+				col = before[line]!.length;
+			const lines = input.text.split("\n");
+			const lookup = async () => {
+				await commandUsage.load();
+				return provider.getSuggestions(lines, line, col, controller.signal);
+			};
+			const suggestions = await Promise.race([lookup(), aborted.promise]);
+			if (controller.signal.aborted) throw new Error("Completion cancelled or timed out");
+			const items: CompletionItem[] = [];
+			let bytes = 0;
+			for (const item of suggestions?.items.slice(0, 256) ?? []) {
+				// applyCompletion describes an edit. Never run onApplied (a local UI side effect) while discovering candidates.
+				const edited = provider.applyCompletion([...lines], line, col, item, suggestions!.prefix);
+				if (edited.onApplied) continue;
+				const text = edited.lines.join("\n");
+				const cursor =
+					edited.lines.slice(0, edited.cursorLine).reduce((sum, part) => sum + part.length + 1, 0) +
+					edited.cursorCol;
+				if (Buffer.byteLength(text) > 65536 || text.includes("\0") || !boundary(text, cursor)) continue;
+				if (text === input.text && cursor === input.cursor) continue;
+				const candidate: CompletionItem = {
+					id: String(items.length),
+					label: item.label,
+					description: item.description,
+					hint: item.hint,
+					kind: "command",
+					...completionEdit(input.text, text),
+					cursor,
+					triggerCompletion: true,
+				};
+				const size = Buffer.byteLength(JSON.stringify(candidate));
+				if (bytes + size > 896 * 1024) break;
+				bytes += size;
+				items.push(candidate);
+			}
+			return { supported: true, items };
+		} finally {
+			clearTimeout(timer);
+			controller.signal.removeEventListener("abort", rejectAbort);
+			if (this.#active === controller) this.#active = undefined;
+		}
+	}
+}
