@@ -0,0 +1,57 @@
+import { expect, test } from "bun:test";
+import { CombinedAutocompleteProvider } from "@oh-my-pi/pi-tui";
+import { completionEdit, validateCompletionInput } from "../../src/slash-commands/session-completion";
+
+test("remote completion edits retain the original nested argument callback and suffix", async () => {
+	const prefixes: string[] = [];
+	const provider = new CombinedAutocompleteProvider(
+		[
+			{
+				name: "native-nested",
+				description: "Dynamic nested command",
+				getArgumentCompletions: prefix => {
+					prefixes.push(prefix);
+					return [{ value: 'first second "a b" ', label: "a b", description: "Third native choice" }];
+				},
+			},
+		],
+		"/tmp",
+	);
+	const text = "/native-nested first second a suffix";
+	const cursor = text.indexOf("a suffix") + 1;
+	const suggestions = await provider.getSuggestions([text], 0, cursor);
+	expect(prefixes).toEqual(["first second a"]);
+	const applied = provider.applyCompletion([text], 0, cursor, suggestions!.items[0]!, suggestions!.prefix);
+	const after = applied.lines.join("\n");
+	const edit = completionEdit(text, after);
+	expect(text.slice(0, edit.replaceRange.start) + edit.insertText + text.slice(edit.replaceRange.end)).toBe(after);
+	expect(after).toContain('first second "a b" ');
+	expect(after).toEndWith(" suffix");
+});
+
+test("minimal remote edits never split surrogate pairs", () => {
+	expect(completionEdit("/x 😀 suffix", "/x 🌟 suffix")).toEqual({
+		insertText: "🌟",
+		replaceRange: { start: 3, end: 5 },
+	});
+	expect(completionEdit("/x a suffix", "/x abc suffix")).toEqual({
+		insertText: "bc",
+		replaceRange: { start: 4, end: 4 },
+	});
+});
+
+test("invalid native editor offsets fail before lookup", () => {
+	for (const value of [
+		{ text: "/x 😀", cursor: 4 },
+		{ text: "/x", cursor: -1 },
+		{ text: "/x", cursor: 1.5 },
+		{ text: "x".repeat(65537), cursor: 0 },
+		{ text: "\0", cursor: 0 },
+	]) {
+		expect(() => validateCompletionInput(value)).toThrow("Invalid completion input");
+	}
+	expect(validateCompletionInput({ text: "/x 😀", cursor: 5 })).toEqual({
+		text: "/x 😀",
+		cursor: 5,
+	});
+});
