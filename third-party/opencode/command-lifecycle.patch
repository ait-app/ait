diff --git a/packages/cli/test/acp/command-lifecycle.test.ts b/packages/cli/test/acp/command-lifecycle.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/cli/test/acp/command-lifecycle.test.ts
@@ -0,0 +1,95 @@
+import { expect, test } from "bun:test"
+import { startSession, delivered, succeeded, textDelta, permissionAsked, interrupted, rpcError } from "./wire-fixture"
+
+test("a command input receipt keeps ACP open through delayed native execution", async () => {
+  const admission = Promise.withResolvers<{ sessionID: string; id: string }>()
+  await using acp = await startSession({
+    onCommand: (request) => {
+      admission.resolve(request)
+      return { inputID: request.id }
+    },
+  })
+  let finished = false
+  const response = acp.prompt(acp.sessionId, "/review some arguments").then((value) => {
+    finished = true
+    return value
+  })
+  const input = await admission.promise
+  expect(finished).toBe(false)
+  acp.server.send(delivered(input.sessionID, input.id), textDelta(input.sessionID, "msg_answer", "native answer"))
+  await acp.until(
+    () => acp.updates.some((entry) => entry.update.sessionUpdate === "agent_message_chunk"),
+    "command output",
+  )
+  expect(finished).toBe(false)
+  acp.server.send(succeeded(input.sessionID))
+  expect((await response).stopReason).toBe("end_turn")
+})
+
+test("a local command without model admission completes without waiting for model events", async () => {
+  await using acp = await startSession({ onCommand: () => ({}) })
+  expect((await acp.prompt(acp.sessionId, "/review status")).stopReason).toBe("end_turn")
+  expect(acp.server.prompts).toHaveLength(0)
+})
+
+test("native questions during a command stay answerable until the correlated terminal", async () => {
+  const admission = Promise.withResolvers<{ sessionID: string; id: string }>()
+  await using acp = await startSession({
+    onCommand: (request) => {
+      admission.resolve(request)
+      return { inputID: request.id }
+    },
+    permission: () => ({ outcome: { outcome: "selected", optionId: "once" } }),
+  })
+  const response = acp.prompt(acp.sessionId, "/review ask")
+  const input = await admission.promise
+  acp.server.send(
+    delivered(input.sessionID, input.id),
+    permissionAsked(input.sessionID, "perm_command", { action: "read" }),
+  )
+  await acp.until(() => acp.server.replies.length === 1, "command permission reply")
+  acp.server.send(succeeded(input.sessionID))
+  expect((await response).stopReason).toBe("end_turn")
+})
+
+test("command arguments retain quoted whitespace and multiline input", async () => {
+  let text = ""
+  await using acp = await startSession({
+    onCommand: (input) => {
+      text = input.text
+      return {}
+    },
+  })
+  await acp.prompt(acp.sessionId, '/review "two  words"  next\nlast  ')
+  expect(text).toBe('"two  words"  next\nlast  ')
+})
+
+test("cancelling a receipted model command waits for its native interruption", async () => {
+  const admission = Promise.withResolvers<{ sessionID: string; id: string }>()
+  await using acp = await startSession({
+    onCommand: (request) => {
+      admission.resolve(request)
+      return { inputID: request.id }
+    },
+    onInterrupt: ({ sessionID }) => [interrupted(sessionID)],
+  })
+  const response = acp.prompt(acp.sessionId, "/review hold")
+  const input = await admission.promise
+  acp.server.send(delivered(input.sessionID, input.id), textDelta(input.sessionID, "msg_command", "working"))
+  await acp.until(
+    () => acp.updates.some((entry) => entry.update.sessionUpdate === "agent_message_chunk"),
+    "command output",
+  )
+  await acp.notify("session/cancel", { sessionId: acp.sessionId })
+  expect((await response).stopReason).toBe("cancelled")
+})
+
+test("a command receipt for a different input fails instead of waiting forever", async () => {
+  await using acp = await startSession({ onCommand: () => ({ inputID: "msg_unrelated" }) })
+  expect(await rpcError(acp.prompt(acp.sessionId, "/review broken"))).toBeDefined()
+})
+
+test("a command receipt cannot transfer settlement ownership to another session", async () => {
+  await using acp = await startSession({ onCommand: (input) => ({ inputID: input.id, sessionID: "ses_unrelated" }) })
+  expect(await rpcError(acp.prompt(acp.sessionId, "/review wrong-session"))).toBeDefined()
+})
