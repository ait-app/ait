{
  "name": "@ait/desktop",
  "version": "0.0.26",
  "private": true,
  "description": "Ait desktop app (Electron wrapper)",
  "homepage": "https://github.com/ait-app/ait",
  "license": "Apache-2.0",
  "author": {
    "name": "Necokeine"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ait-app/ait.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/prepare-daemon.mjs && npm run build:main && electron-builder --config electron-builder.yml --publish never",
    "build:main": "tsc -p tsconfig.json",
    "capture-harness": "npm run build:main && ./capture-harness/run.sh",
    "dev": "./scripts/dev.sh",
    "dev:win": "powershell ./scripts/dev.ps1",
    "test:e2e:renderer": "cross-env E2E_DESKTOP_RUNTIME=1 playwright test --config=playwright.config.ts --project=desktop",
    "verify:electron-cdp": "node ./scripts/verify-electron-cdp.mjs",
    "test": "install-electron && vitest run --exclude \"e2e/**\"",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test:e2e:lifecycle": "npm run test:e2e:rust-startup",
    "test:e2e:server-listen": "install-electron && npm run build:main && node e2e/server-listen.e2e.mjs",
    "test:e2e:settings-rust": "install-electron && node e2e/settings-rust.e2e.mjs",
    "test:e2e:rust-startup": "install-electron && npm run build:main && node e2e/rust-startup.e2e.mjs",
    "build:dmg": "node scripts/build-macos.mjs",
    "build:dmg:release": "node scripts/build-macos.mjs --signed",
    "package:linux": "node scripts/package-release.mjs linux",
    "package:mac": "node scripts/package-release.mjs mac"
  },
  "dependencies": {
    "@ait/client": "file:../../packages/client",
    "@ait/protocol": "file:../../packages/protocol",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "ws": "^8.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "24.6.0",
    "@types/ws": "^8.5.14",
    "electron": "44.2.0",
    "electron-builder": "26.8.1",
    "typescript": "5.9.3",
    "unzip-crx-3": "^0.2.0",
    "vitest": "^4.1.6",
    "wait-on": "8.0.5"
  },
  "desktopName": "Ait.desktop"
}
