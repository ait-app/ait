{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "ait": {
      "extends": "production",
      "distribution": "store",
      "node": "22.23.3",
      "env": {
        "EXPO_OWNER": "sd542927172s-team",
        "EXPO_SLUG": "ait",
        "EAS_PROJECT_ID": "379ada50-82c0-4d4a-bac9-cb8c113cf38d",
        "IOS_BUNDLE_IDENTIFIER": "com.necokeine.ait",
        "APPLE_TEAM_ID": "SVS7GV79T9"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "production": {
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "resourceClass": "large"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "resourceClass": "medium",
        "env": {
          "AIT_ANDROID_HERMES_O0": "1"
        },
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -x lint -x lintVitalAnalyzeRelease -x lintVitalRelease -x generateReleaseLintModel -x generateReleaseLintVitalModel"
      }
    },
    "production-play": {
      "extends": "ait",
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "resourceClass": "medium",
        "env": {
          "AIT_ANDROID_HERMES_O0": "1"
        },
        "buildType": "app-bundle"
      }
    },
    "simulator": {
      "extends": "production",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal"
    }
  },
  "submit": {
    "play-internal": {
      "android": {
        "applicationId": "dev.ait.mobile",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "play-internal-draft": {
      "extends": "play-internal",
      "android": {
        "releaseStatus": "draft"
      }
    },
    "ait": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6817043477",
        "appleTeamId": "SVS7GV79T9",
        "bundleIdentifier": "com.necokeine.ait"
      }
    },
    "production": {
      "ios": {},
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
